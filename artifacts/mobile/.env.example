# =============================================================================
# Mobile App — Environment Variables (Expo)
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# All variables must be prefixed with EXPO_PUBLIC_ to be accessible in the app.
# =============================================================================

# ── API URL ──────────────────────────────────────────────────────────────────
# Full URL of the running API server.
#
# iOS Simulator / Android Emulator on the same machine:
EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Physical device on the same Wi-Fi network (replace with YOUR machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# Production / hosted API:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
