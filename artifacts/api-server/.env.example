# =============================================================================
# API Server — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
# Port the Express server listens on (required)
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Local (Docker Compose):  postgresql://postgres:postgres@localhost:5432/smart_wardrobe
# Supabase:                postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_wardrobe

# ── OpenAI ──────────────────────────────────────────────────────────────────
# OpenAI API key — required for clothing scan, outfit recommendation, try-on
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# OpenAI base URL — override for Azure OpenAI or proxy; leave default for openai.com
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
