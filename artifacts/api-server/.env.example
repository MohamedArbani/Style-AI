# =============================================================================
# API Server — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ── Server ─────────────────────────────────────────────────────────────────
# Port the Express server listens on (required)
PORT=3000

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Local (Docker Compose):  postgresql://postgres:postgres@localhost:5432/smart_wardrobe
# Supabase:                postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_wardrobe

# ── OpenRouter ──────────────────────────────────────────────────────────────
# OpenRouter API key — required for clothing scan and outfit recommendation
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── HuggingFace ─────────────────────────────────────────────────────────────
# HuggingFace API key — kept for other AI features if needed
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# ── RapidAPI Virtual Try-On ──────────────────────────────────────────────────
# Required for the AI virtual try-on feature
# Get your key at https://rapidapi.com/visual-layer-visual-layer-default/api/virtual-try-on7
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=virtual-try-on7.p.rapidapi.com

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
